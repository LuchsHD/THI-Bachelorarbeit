{
	"latex-workshop.latex.tools": [
		{
			"name": "pdflatex",
			"command": "pdflatex",
			"args": [
				"-synctex=1",
				"-interaction=nonstopmode",
				"-file-line-error",
				"%DOC%"
			]
		},
		{
			"name": "bibtex",
			"command": "bibtex",
			"args": [
				"%DOCFILE%"
			]
		},
		{
			"name": "makeglossaries",
			"command": "makeglossaries",
			"args": [
				"%DOCFILE%"
			]
		},
		{
			"name": "makenomenclature",
			"command": "makeindex",
			"args": [
				"%DOCFILE%.nlo",
				"-s",
				"nomencl.ist",
				"-o",
				"%DOCFILE%.nls"
			]
		}
	],
	"latex-workshop.latex.recipes": [
		{
			"name": "pdflatex (quick)",
			"tools": [
				"pdflatex"
			]
		},
		{
			"name": "pdflatex x2 (mit Verzeichnissen/Referenzen)",
			"tools": [
				"pdflatex",
				"pdflatex"
			]
		},
		{
			"name": "Full (Bibliografie + Glossar + Nomenklatur)",
			"tools": [
				"pdflatex",
				"bibtex",
				"makeglossaries",
				"makenomenclature",
				"pdflatex",
				"pdflatex"
			]
		}
	],
	"latex-workshop.latex.recipe.default": "first",
	"latex-workshop.latex.autoBuild.run": "onSave",
	"latex-workshop.latex.clean.fileTypes": [
		"*.aux",
		"*.bbl",
		"*.blg",
		"*.idx",
		"*.ind",
		"*.lof",
		"*.lot",
		"*.out",
		"*.toc",
		"*.acn",
		"*.acr",
		"*.alg",
		"*.glg",
		"*.glo",
		"*.gls",
		"*.ist",
		"*.fls",
		"*.log",
		"*.fdb_latexmk",
		"*.nlo",
		"*.nls",
		"*.synctex.gz"
	]
}
